rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Annotated measurement photos
    // Path: annotated/{orgId}/{jobId}.jpg
    // Access is gated at the app level: the download URL is stored on the
    // job doc, which Firestore rules already restrict to org members.
    // Only require a signed-in user here.
    match /annotated/{orgId}/{file} {
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
