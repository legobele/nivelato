  "meta": {
    "consumedBy": [
      "nivelato-repo (web)",
      "nivelato-android (Compose M3 mappings)"
    ],
    "languageNote": "UI text stays Spanish (es-PR)",
    "name": "Nivelato Design Tokens",
    "sourceOfTruth": "nivelato-design-system/design-system.md \u00a71",
    "version": "1.1.0"
  },
  "motion": {
    "button-active-scale": "0.98",
    "fade-up": "0.25s",
    "progress-width": "0.4s",
    "sheet-slide-up": "0.22s",
    "toast-slide-fade": "0.25s",
    "warn-pulse": "1.6s"
  },
  "radius": {
    "card": "18px",
    "md": "14px",
    "modal": "24px",
    "pill": "9999px",
    "sm": "12px",
    "tag": "6px",
    "xs": "8px"
  },
  "shadow": {
    "lg": "0 4px 12px rgba(0,0,0,0.08), 0 12px 32px rgba(0,0,0,0.10)",
    "md": "0 2px 6px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0,0.08)",
    "modal": "0 4px 16px rgba(0,0,0,0.12), 0 16px 48px rgba(0,0,0,0.18)",
    "sm": "0 1px 2px rgba(0,0,0,0.05), 0 2px 8px rgba(0,0,0,0.06)"
  },
  "spacing": {
    "min-touch-target": "48dp",
    "scale": [
      4,
      6,
      8,
      10,
      12,
      16,
      20,
      24,
      28,
      32,
      40
    ],
    "unit": "px"
  },
  "typography": {
    "body": {
      "size": "15px",
      "weight": "400-500"
    },
    "body-sm": {
      "size": "14px",
      "weight": "400-600"
    },
    "code": {
      "font-family": "monospace",
      "letter-spacing": "0.15em",
      "size": "24px",
      "weight": 700
    },
    "display": {
      "size": "28px",
      "weight": 700
    },
    "font-family": "'Inter', system-ui, sans-serif",
    "fraction": {
      "align": "center",
      "size": "1.6rem",
      "weight": 700
    },
    "h1": {
      "mobile-size": "18px",
      "size": "22px",
      "weight": 700
    },
    "label": {
      "letter-spacing": "0.4-0.5px",
      "size": "12px",
      "uppercase": true,
      "weight": 600
    },
    "letter-spacing": {
      "logo": "-0.02em"
    },
    "line-height": {
      "base": 1.5,
      "modal-body": 1.6
    },
    "small": {
      "size": "13px",
      "weight": "400-600"
    },
    "step-title": {
      "size": "1.1rem",
      "weight": 700
    },
    "tiny": {
      "size": "11px",
      "weight": 600
    },
    "title": {
      "mobile-size": "16px",
      "size": "18px",
      "weight": 700
    }
  }
