import assert from 'node:assert/strict';
import { qrView } from '../src/core/workshopQr.ts';
const mine = { url: 'u', qrSvg: '<svg/>', createdAt: '2026-11-24T10:00:00Z' };
assert.equal(qrView({ status: 'none' }, null), 'none');
assert.equal(qrView(null, null), 'none');
assert.equal(qrView({ status: 'pending', createdAt: '2026-11-24T10:00:00.000Z' }, mine), 'ours');
assert.equal(qrView({ status: 'pending', createdAt: '2026-11-24T11:00:00Z' }, mine), 'elsewhere');
assert.equal(qrView({ status: 'pending', createdAt: '2026-11-24T10:00:00Z' }, null), 'elsewhere');
for (const s of ['used', 'expired', 'superseded', 'revoked'] as const) assert.equal(qrView({ status: s }, mine), 'spent');
console.log('workshopQr ok');
