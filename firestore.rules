rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // True when a field is identical before/after the write, treating
    // "absent on both sides" as unchanged. Real user docs often lack
    // optional fields (e.g. permissions), so a naive == comparison would
    // wrongly deny legitimate self-edits.
    function unchanged(field) {
      return (!(field in resource.data) && !(field in request.resource.data))
          || (field in resource.data && field in request.resource.data
              && request.resource.data[field] == resource.data[field]);
    }

    // Users: own read/write, or same-org read (for permission manager).
    // role / orgId / permissions / disabled are immutable on self-update:
    // no self-promotion, no cross-org poaching, no self-approval.
    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        myUser().orgId ==
          get(/databases/$(database)/documents/users/$(userId)).data.orgId
      );
      allow update: if isSignedIn() && (
        // self-update: profile fields only (e.g. name); role/orgId/
        // permissions/disabled immutable
        (request.auth.uid == userId
          && unchanged('role')
          && unchanged('orgId')
          && unchanged('permissions')
          && unchanged('disabled'))
        // owner managing same-org members (approve/reject/roles/permissions);
        // orgId immutable so members can't be poached across orgs
        || (myUser().role == 'owner'
          && myUser().orgId == resource.data.orgId
          && request.resource.data.orgId == resource.data.orgId)
      );
      // No client-side deletes, period. Deleting your own doc and recreating
      // it was a full privilege-escalation bypass (recreate as owner), and
      // `create` can't tell a legit signup from a recreate. Account/doc
      // removal happens in the Firebase Console, which bypasses rules.
      allow delete: if false;
    }

    // Orgs: anyone signed in can CREATE (signup bootstrap — the user doc
    // doesn't exist yet when the org doc is written). Owner can update/delete,
    // members can read.
    match /orgs/{orgId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && myUser().orgId == orgId;
      allow update, delete: if isSignedIn()
        && myUser().role == 'owner' && myUser().orgId == orgId;

      // Jobs: org members can create + read; shared users can read.
      // Update/delete: owner/supervisor can touch any org job; anyone can
      // edit or delete measurements they created themselves (matches
      // canEditJob() in permissions.js).
      match /jobs/{jobId} {
        allow create: if isSignedIn() && myUser().orgId == orgId;
        allow read: if isSignedIn() && (
          myUser().orgId == orgId ||
          resource.data.sharedWith.hasAny([request.auth.uid])
        );
        allow update, delete: if isSignedIn() && myUser().orgId == orgId && (
          myUser().role in ['owner', 'supervisor'] ||
          request.auth.uid == resource.data.installerUid
        );
      }
    }
  }
}
