rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myUid() {
      return request.auth.uid;
    }
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(myUid()));
    }
    function myUser() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }
    // Active member: has a user doc and is not disabled (pending/rejected).
    // Disabled users keep self-read (so the app can show the pending screen)
    // but lose all org data access — enforced here, not just in the UI.
    function isActive() {
      return hasUserDoc()
          && (!('disabled' in myUser()) || myUser().disabled == false);
    }
    function myOrgId() {
      return myUser().orgId;
    }
    // True when a field is identical before/after the write, treating
    // "absent on both sides" as unchanged. Real user docs often lack
    // optional fields (e.g. permissions), so a naive == comparison would
    // wrongly deny legitimate self-edits.
    function unchanged(field) {
      return (!(field in resource.data) && !(field in request.resource.data))
          || (field in resource.data && field in request.resource.data
              && request.resource.data[field] == resource.data[field]);
    }

    // Users.
    // - get: own doc, or same-org (single reads need no per-doc get()).
    // - list: same-org only, via resource.data (NOT get(users/{id}) — a
    //   per-document get() makes every list query fail).
    // - update: self may edit profile fields only (role/orgId/permissions/
    //   disabled immutable — no self-promotion, no self-approval); owners
    //   may manage same-org members (approve/reject/roles/permissions).
    // - create/delete: self-create only (signup); NO client deletes —
    //   delete+recreate was a full privilege-escalation bypass. Doc removal
    //   happens in the Firebase Console, which bypasses rules.
    match /users/{userId} {
      allow create: if isSignedIn() && myUid() == userId;
      allow get: if isSignedIn() && (
        myUid() == userId ||
        (isActive() && myOrgId() == resource.data.orgId)
      );
      allow list: if isSignedIn() && isActive()
        && myOrgId() == resource.data.orgId;
      allow update: if isSignedIn() && (
        (myUid() == userId
          && unchanged('role')
          && unchanged('orgId')
          && unchanged('permissions')
          && unchanged('disabled'))
        || (isActive()
          && myUser().role == 'owner'
          && myOrgId() == resource.data.orgId
          && request.resource.data.orgId == resource.data.orgId)
      );
      allow delete: if false;
    }

    // Orgs.
    // - create: anyone signed in (signup bootstrap).
    // - read: active members, PLUS users with no user doc yet — they are
    //   mid-signup validating a join code (the user doc is created after).
    //   Org docs only carry name/joinCode/ownerId, safe to expose there.
    // - update/delete: owner of the org.
    match /orgs/{orgId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        !hasUserDoc() ||
        (isActive() && myOrgId() == orgId)
      );
      allow update, delete: if isActive()
        && myUser().role == 'owner' && myOrgId() == orgId;

      // Jobs.
      // - create/read: active org members; read also for shared users.
      // - update/delete: owner/supervisor any org job; anyone own jobs
      //   they created (matches canEditJob() in permissions.js).
      // - orgId comes from the path wildcard: no per-doc get(), so lists
      //   scale.
      match /jobs/{jobId} {
        allow create: if isActive() && myOrgId() == orgId;
        allow read: if isActive() && (
          myOrgId() == orgId ||
          resource.data.sharedWith.hasAny([myUid()])
        );
        allow update, delete: if isActive() && myOrgId() == orgId && (
          myUser().role in ['owner', 'supervisor'] ||
          myUid() == resource.data.installerUid
        );
      }
    }
  }
}
